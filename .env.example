APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
SQLALCHEMY_DATABASE_URI=postgresql://user:password@localhost:5432/insight_crm

# Voice agent secrets (server-side only)
DEEPGRAM_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+14165550123
PUBLIC_BASE_URL=https://your-public-api.example.com
TWILIO_VALIDATE_SIGNATURES=true
AUTO_CREATE_TABLES=true
FRONTEND_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Optional Deepgram agent models
VOICE_LLM_MODEL=gpt-4.1-mini
VOICE_MODEL=aura-2-thalia-en

# TaxGPT uses the shared database, secret, frontend origins, and web process.
# Apply app/taxgpt/migrations/001_create_taxgpt_tables.sql before production
# deployment and set both auto-create variables to false there.
TAXGPT_AUTO_CREATE_TABLES=true
TAXGPT_COOKIE_SECURE=false
TAXGPT_MAX_FILE_BYTES=10485760
TAXGPT_SESSION_HOURS=12
TAXGPT_REMEMBER_DAYS=7
TAXGPT_AUTH_RATE_LIMIT=10
TAXGPT_DEMO_RATE_LIMIT=5
TAXGPT_TRUST_PROXY_HEADERS=false
TAXGPT_OPENAI_TIMEOUT_SECONDS=30
TAXGPT_OPENAI_MAX_RETRIES=2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Openmart uses the shared database, secret, origins, and frontend URL.
OPENMART_AUTO_CREATE_TABLES=true
OPENMART_COOKIE_SECURE=false
OPENMART_SESSION_HOURS=12
OPENMART_REMEMBER_DAYS=7
OPENMART_AUTH_RATE_LIMIT=10
OPENMART_TRUST_PROXY_HEADERS=false

# Development-only seed login. Keep disabled in production and provide both
# credentials explicitly whenever it is enabled.
OPENMART_SEED_ENABLED=false
OPENMART_SEED_EMAIL=
OPENMART_SEED_PASSWORD=
OPENMART_SEED_DISPLAY_NAME=Openmart Demo
OPENMART_SEED_WORKSPACE=Openmart Demo
